{
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_TITLE='Claude Code' HOOK_MESSAGE='needs your attention' \"$CLAUDE_PROJECT_DIR/config/cli/hooks/scripts/notify.sh\" || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/config/cli/hooks/scripts/protect-files.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/config/cli/hooks/scripts/post-compact-context.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/config/cli/hooks/scripts/audit-log.sh\""
          }
        ]
      }
    ]
  }
}
